{
  "name": "Datavez",
  "short_name": "Datavez",
  "description": "Local document vault to save and quickly find important documents like Aadhar, marksheets and certificates.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1C1A15",
  "theme_color": "#1C1A15",
  "orientation": "portrait",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "sharedFile",
          "accept": ["image/*", "application/pdf", ".pdf", ".zip", ".html", ".txt", ".doc", ".docx", "*/*"]
        }
      ]
    }
  }
}
